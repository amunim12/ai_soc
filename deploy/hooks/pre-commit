#!/usr/bin/env bash
# Pre-commit hook — blocks commits that contain secrets or sensitive files.
# Install: cp deploy/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

fail() {
    echo -e "${RED}[pre-commit] BLOCKED:${NC} $1" >&2
}

warn() {
    echo -e "${YELLOW}[pre-commit] WARNING:${NC} $1" >&2
}

ERRORS=0

# ── 1. Block sensitive file extensions ───────────────────────────────────────
BLOCKED_EXTENSIONS="\.pem$|\.key$|\.p12$|\.pfx$|\.crt$|\.csr$|\.jks$|\.keystore$"
while IFS= read -r file; do
    if echo "$file" | grep -qE "$BLOCKED_EXTENSIONS"; then
        fail "Credential file staged: $file"
        ERRORS=$((ERRORS + 1))
    fi
done < <(git diff --cached --name-only)

# ── 2. Block .env files (only .env.example is allowed) ───────────────────────
while IFS= read -r file; do
    if echo "$file" | grep -qE "^\.env$|/\.env$|\.env\.[^e]|\.env\.local"; then
        fail ".env file staged: $file — use .env.example for templates"
        ERRORS=$((ERRORS + 1))
    fi
done < <(git diff --cached --name-only)

# ── 3. Scan staged content for secret patterns ────────────────────────────────
SECRET_PATTERNS=(
    # Generic high-entropy patterns
    "['\"][0-9a-fA-F]{40,}['\"]"              # 40+ hex chars in quotes
    "['\"][A-Za-z0-9+/]{50,}={0,2}['\"]"      # Long base64 strings

    # Specific key formats
    "AKIA[0-9A-Z]{16}"                        # AWS access key
    "sk-[a-zA-Z0-9]{20,}"                     # OpenAI API key
    "ghp_[a-zA-Z0-9]{36}"                     # GitHub personal access token
    "github_pat_[a-zA-Z0-9_]{82}"             # GitHub fine-grained PAT
    "xox[baprs]-[0-9a-zA-Z]{10,}"            # Slack token
    "-----BEGIN.*PRIVATE KEY-----"

    # Placeholder violations (exclude settings.py defaults)
    "CHANGE_ME(?!>)"                           # Literal CHANGE_ME not in a template
    "soc-pipeline-dev-secret"
    "Admin@SOC2025"
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for file in $STAGED_FILES; do
    # Skip binary files, .env.example, package-lock, and this hook itself
    [[ "$file" == *".env.example" ]] && continue
    [[ "$file" == *"package-lock.json" ]] && continue
    [[ "$file" == *"pre-commit" ]] && continue
    [[ ! -f "$file" ]] && continue

    for pattern in "${SECRET_PATTERNS[@]}"; do
        if git diff --cached "$file" | grep "^+" | grep -qE "$pattern"; then
            fail "Possible secret in $file matching pattern: $pattern"
            ERRORS=$((ERRORS + 1))
        fi
    done
done

# ── 4. Warn if JWT_SECRET_KEY placeholder is in staged content ────────────────
for file in $STAGED_FILES; do
    [[ "$file" == *".env.example" ]] && continue
    [[ ! -f "$file" ]] && continue
    if git diff --cached "$file" | grep "^+" | grep -qE "JWT_SECRET_KEY=.{1,50}$"; then
        warn "JWT_SECRET_KEY appears to be set in $file — verify it is not a real secret"
    fi
done

# ── Result ────────────────────────────────────────────────────────────────────
if [[ $ERRORS -gt 0 ]]; then
    echo -e "\n${RED}Commit blocked — $ERRORS issue(s) found.${NC}" >&2
    echo "Fix the issues above, then retry. To bypass in an emergency:" >&2
    echo "  git commit --no-verify  (USE ONLY WITH EXPLICIT SECURITY LEAD APPROVAL)" >&2
    exit 1
fi

exit 0
