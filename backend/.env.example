# ══════════════════════════════════════════════════════════════════════════════
# AI SOC — environment configuration template
#
# Copy this file to .env and fill in every value marked <CHANGE_ME>.
# NEVER commit .env to version control.
#
# Generate a secure JWT secret:
#   python -c "import secrets; print(secrets.token_hex(64))"
# ══════════════════════════════════════════════════════════════════════════════


# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED — must be a random 64-byte hex string, never the example value
JWT_SECRET_KEY=<CHANGE_ME>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Initial admin credentials (generated randomly on first run if not set)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=<CHANGE_ME>


# ─── Local LLM ────────────────────────────────────────────────────────────────
# Point to your local vLLM / Ollama server — no cloud endpoint allowed
LOCAL_LLM_BASE_URL=http://localhost:8001/v1
LOCAL_LLM_MODEL=hugging-quants/Meta-Llama-3.3-70B-Instruct-AWQ-INT4
LOCAL_LLM_API_KEY=<CHANGE_ME>
LOCAL_AI_ONLY=true

# Optional — only needed if downloading models from HuggingFace before air-gap
HUGGING_FACE_HUB_TOKEN=


# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=ai_soc
KAFKA_NUM_CONSUMER_WORKERS=8
KAFKA_LINGER_MS=50
KAFKA_BATCH_SIZE_BYTES=524288
KAFKA_FETCH_MIN_BYTES=65536
KAFKA_FETCH_WAIT_MAX_MS=200


# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:<CHANGE_ME>@localhost:6379/0


# ─── ChromaDB ���────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8888


# ─── Database ─────────────────────────────────────────────────────────────────
# Set POSTGRES_DSN to use PostgreSQL (recommended for production).
# Leave unset to fall back to SQLite (development only).
POSTGRES_DSN=postgresql://soc:<CHANGE_ME>@localhost:5432/soc_pipeline
SQLITE_DB_PATH=./data/hitl.db


# ─── Wazuh REST API ───────────────────────────────────────────────────────────
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_USER=wazuh-wui
WAZUH_PASSWORD=<CHANGE_ME>

# Wazuh OpenSearch indexer
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=<CHANGE_ME>


# ─── Threat Intelligence ──────────────────────────────────────────────────────
# All optional. Set USE_MOCK_TI=true to disable live TI lookups (air-gap safe).
USE_MOCK_TI=true

VIRUSTOTAL_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
MISP_URL=https://misp-host:443
MISP_API_KEY=
MAXMIND_DB_PATH=./data/GeoLite2-City.mmdb


# ─── Notifications ────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=soc@example.com
SMTP_PASSWORD=
SMTP_FROM=soc@example.com
ANALYST_EMAIL=analyst@example.com


# ─── Pipeline tuning ──────────────────────────────────────────────────────────
HITL_TIMEOUT_SECONDS=900
HITL_ESCALATE_SECONDS=600
CONFIDENCE_THRESHOLD=0.85
LOG_LEVEL=INFO
PLAYBOOK_FAST_MODE=false
TI_LOOKUP_TIMEOUT_SECONDS=10
SOAR_ENABLED=false


# ── Pipeline Concurrency & Throughput ────────────────────────────────────────
# Max alerts in-flight across all consumer workers (semaphore cap).
# At 1100 EPS with ~4s LLM latency you need at least 512.
PIPELINE_MAX_CONCURRENT_ALERTS=512

# Number of Kafka consumer workers. Must be <= number of topic partitions (48).
KAFKA_NUM_CONSUMER_WORKERS=16

# Max concurrent LLM inference calls. Each call holds a GPU context slot.
# Set to match vLLM --max-num-seqs (typically 64-128 on A100 80 GB).
LLM_MAX_CONCURRENT_CALLS=64

# Timeout for a single LLM completion call (seconds).
LLM_CALL_TIMEOUT_SECONDS=30.0

# How long (seconds) to cache generated playbooks keyed on (category, MITRE).
PLAYBOOK_CACHE_TTL_SECONDS=3600

# How long (seconds) to cache RAG context keyed on (category, MITRE).
RAG_CTX_CACHE_TTL_SECONDS=3600

# ── Wazuh Bridge Ingestion ───────────────────────────────────────────────────
# Seconds between Wazuh API polls. 1 = poll every second.
WAZUH_POLL_INTERVAL=1

# Max alerts fetched per poll. 1200 at 1s interval = 1200 EPS ceiling.
WAZUH_BATCH_SIZE=1200

# ── Infrastructure Passwords (required in production) ────────────────────────
POSTGRES_PASSWORD=<CHANGE_ME>
REDIS_PASSWORD=<CHANGE_ME>


# ─── Shuffle SOAR ─────────────────────────────────────────────────────────────
SHUFFLE_BASE_URL=http://localhost:5001
SHUFFLE_API_KEY=<CHANGE_ME>
SHUFFLE_WORKFLOW_IDS_PATH=./data/shuffle_workflow_ids.json
SHUFFLE_EXECUTION_TIMEOUT=900
SHUFFLE_POLL_INTERVAL=5


# ─── Internal service URLs (used by register_shuffle_workflows.py) ────────────
FASTAPI_INTERNAL_URL=http://localhost:8000
WAZUH_AR_URL=http://wazuh-manager:55000
FIREWALL_URL=http://firewall-host:8080
THEHIVE_URL=http://thehive-host:9000
LDAP_API_URL=http://ldap-api-host:8080


# ─── Dashboard URLs ───────────────────────────────────────────────────────────
WAZUH_DASHBOARD_URL=https://localhost:443
SHUFFLE_DASHBOARD_URL=http://localhost:3001


# ─── RAG ──────────────────────────────────────────────────────────────────────
RAG_UPLOAD_MAX_MB=50
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
