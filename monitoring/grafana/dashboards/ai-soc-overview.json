{
  "title": "AI SOC Overview",
  "uid": "ai-soc-overview",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(soc_http_requests_total[5m]))",
        "legendFormat": "req/s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 50}, {"color": "red", "value": 200}] }
        }
      }
    },
    {
      "id": 2,
      "title": "Pending HITL Reviews",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "soc_hitl_pending_reviews",
        "legendFormat": "pending"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 10}, {"color": "red", "value": 50}] }
        }
      }
    },
    {
      "id": 3,
      "title": "Alerts Processed (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(increase(soc_alerts_processed_total[1h]))",
        "legendFormat": "alerts"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "Pipeline Errors (1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(increase(soc_pipeline_errors_total[1h]))",
        "legendFormat": "errors"
      }],
      "fieldConfig": {
        "defaults": {
          "thresholds": { "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}] }
        }
      }
    },
    {
      "id": 5,
      "title": "API Request Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by (path) (rate(soc_http_requests_total[5m]))",
        "legendFormat": "{{path}}"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6,
      "title": "API Latency p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(soc_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(soc_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(soc_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 7,
      "title": "HITL Decisions by Action (24h)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by (action) (increase(soc_hitl_decisions_total[24h]))",
        "legendFormat": "{{action}}"
      }]
    },
    {
      "id": 8,
      "title": "Alert Outcomes (24h)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum by (outcome) (increase(soc_alerts_processed_total[24h]))",
        "legendFormat": "{{outcome}}"
      }]
    },
    {
      "id": 9,
      "title": "LLM Call Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "histogram_quantile(0.95, sum(rate(soc_llm_call_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95 LLM latency"
      }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
